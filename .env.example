APP_ENV=development
LOG_LEVEL=info
APP_NAME=huihui-fast-api

# AdMob (load from GitHub Secrets / KMS / Vault in production)
ADMOB_CLIENT_ID=
ADMOB_CLIENT_SECRET=
ADMOB_REFRESH_TOKEN=
ADMOB_PUBLISHER_ID=
# Optional: pre-existing access token + expiry (will be auto-refreshed)
ADMOB_ACCESS_TOKEN=
ADMOB_EXPIRY_DATE=0