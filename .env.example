APP_ENV=development
LOG_LEVEL=info
APP_NAME=huihui-fast-api

# AdMob (load from GitHub Secrets / KMS / Vault in production)
ADMOB_CLIENT_ID=
ADMOB_CLIENT_SECRET=
ADMOB_…KEN=
ADMOB_PUBLISHER_ID=
# Optional: pre-existing access token + expiry (will be auto-refreshed)
ADMOB_ACCESS_TOKEN=
ADMOB_…TE=0

# Gmail (uses the same OAuth client as AdMob by default — reuse or override)
GMAIL_CLIENT_ID=            # defaults to ADMOB_CLIENT_ID if unset
GMAIL_CLIENT_SECRET=        # defaults to ADMOB_CLIENT_SECRET if unset
GMAIL_…KEN=
# Optional: pre-existing Gmail access token + expiry
GMAIL_ACCESS_TOKEN=
GMAIL_EXPIRY_DATE=0
# State persistence path (used by /gmail/feedback)
GMAIL_STATE_PATH=/data/gmail_feedback_state.json
GMAIL_DEFAULT_QUERY=subject:solat OR subject:prayer OR subject:malaysia

# GitHub (for creating feedback issues)
# NOTE: GitHub reserves the `GITHUB_` prefix for system secrets,
# so we use FEEDBACK_GH_TOKEN + TARGET_REPO here.
FEEDBACK_GH_TOKEN=
TARGET_REPO=daian999/TimerApp